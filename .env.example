PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database (Required)
DB_USER="root"
DB_PASS="password"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="microfinance"

# If running Prisma CLI manually (prisma db push, etc.), you might need this uncommented locally:
# DATABASE_URL="mysql://root:password@127.0.0.1:3306/microfinance"

# Auth (Required)
JWT_SECRET="generate-a-secure-random-string-for-this"
JWT_REFRESH_SECRET="generate-another-secure-random-string-for-this"

# CORS
# For production, set to your frontend domain (e.g., https://app.yourdomain.com)
# Multiple domains can be comma-separated
CORS_ORIGIN="*"

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# S3 / MinIO Configuration (For file uploads)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=microfinance-uploads

# SMTP / Email Configuration (For reports and notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password