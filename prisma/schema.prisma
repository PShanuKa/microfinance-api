// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  fullname  String
  email     String   @unique
  password  String
  role      Role     @default(LOAN_OFFICER)
  status    Boolean  @default(true)
  branch    Json?    // Array of branch names or IDs
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens  RefreshToken[]
  officerGroups  Group[]        @relation("OfficerGroups")
  approvedLoans  Loan[]         @relation("ApprovedLoans")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(500)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("refresh_tokens")
}

model Client {
  id          String   @id @default(cuid())
  clientNo    String   @unique // C-001, etc.
  fullname    String
  nic         String   @unique
  phone       String
  address     String?  @db.Text
  job         String?
  status      ClientStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groupMembers GroupMember[]
  instalments  Instalment[]
  guarantors   Guarantor[]

  profileImageId String?
  profileImage   Attachment? @relation("ProfileImage", fields: [profileImageId], references: [id])

  documents      ClientDocument[]

  @@map("clients")
}

model Group {
  id            String   @id @default(cuid())
  name          String
  branch        String
  location      String?
  collectionDay Int      // 1 = Monday, 7 = Sunday
  officerId     String
  officer       User     @relation("OfficerGroups", fields: [officerId], references: [id])
  
  status        Boolean  @default(true)
  
  members       GroupMember[]
  loans         Loan[]
  collections   Collection[]

  createdBy     String
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  isLeader  Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, clientId])
  @@map("group_members")
}

model Guarantor {
  id        String   @id @default(cuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  
  fullname  String
  nic       String
  phone     String
  address   String   @db.Text
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guarantors")
}

model Loan {
  id                   String   @id @default(cuid())
  loanNo               String   @unique // L-000001, etc.
  groupId              String
  group                Group    @relation(fields: [groupId], references: [id])
  
  leaderLentAmount     Decimal   @db.Decimal(10, 2)
  memberLentAmount     Decimal   @db.Decimal(10, 2)
  totalWeeks           Int
  leaderWeeklyAmount   Decimal   @db.Decimal(10, 2)
  memberWeeklyAmount   Decimal   @db.Decimal(10, 2)
  processingFee        Decimal   @db.Decimal(10, 2)
  
  status               LoanStatus @default(DRAFT)
  rejectionReason      String?    @db.Text
  approvedById         String?
  approvedBy           User?      @relation("ApprovedLoans", fields: [approvedById], references: [id])

  instalments          Instalment[]
  guarantors           Guarantor[]

  createdBy            String
  updatedBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("loans")
}

model Instalment {
  id               String   @id @default(cuid())
  loanId           String
  loan             Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id])
  
  weekNumber       Int       // 1, 2, 3...
  dueDate          DateTime  @db.Date
  dueAmount        Decimal   @db.Decimal(10, 2)
  paidAmount       Decimal   @default(0.00) @db.Decimal(10, 2)
  remainingDue     Decimal   @db.Decimal(10, 2) // dueAmount - paidAmount
  status           PaymentStatus @default(UNPAID)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([loanId, clientId, weekNumber])
  @@map("instalments")
}

model DBVersion {
  id        String   @id @default(cuid())
  version   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("db_versions")
}

enum Role {
  ADMIN
  BRANCH_MANAGER
  LOAN_OFFICER
  COLLECTION_OFFICER
  APPROVER
  AUDITOR
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum LoanStatus {
  DRAFT
  PENDING
  APPROVED
  ACTIVE 
  REJECTED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

model Collection {
  id               String   @id @default(cuid())
  groupId          String
  group            Group    @relation(fields: [groupId], references: [id])
  date             DateTime
  instalmentNumber Int
  collectorId      String
  amountCollected  Decimal  @db.Decimal(10, 2)
  bankReference    String?
  breakdownNotes   String?  @db.Text
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("collections")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  userId    String
  details   Json?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model Settings {
  id                   String   @id @default("default")
  
  // Blacklist Settings
  lateWeeksFlag        Int      @default(3)
  
  // Loan Settings
  minLoanWeeks         Int      @default(4)
  maxLoanWeeks         Int      @default(52)
  defaultLoanWeeks     Int      @default(50)
  maxActiveLoansGroup  Int      @default(1)
  
  updatedAt            DateTime @updatedAt

  @@map("settings")
}

model NonCollectionWeek {
  id        String   @id @default(cuid())
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("non_collection_weeks")
}

model Attachment {
  id        String   @id @default(cuid())
  fileName  String
  fileType  String
  fileSize  Int
  fileUrl   String   @db.Text
  bucket    String
  objectKey String
  createdAt DateTime @default(now())

  profileClients Client[] @relation("ProfileImage")
  documents      ClientDocument[]

  @@map("attachments")
}

model ClientDocument {
  id           String     @id @default(cuid())
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  attachmentId String
  attachment   Attachment @relation(fields: [attachmentId], references: [id])
  type         String     // NIC_FRONT, NIC_BACK, ADDRESS_PROOF, BILLING_PROOF, OTHER
  createdAt    DateTime   @default(now())

  @@map("client_documents")
}
