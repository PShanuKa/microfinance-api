// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  fullname  String
  email     String   @unique
  password  String
  roles     Json     @default("[\"LOAN_OFFICER\"]")
  status    Boolean  @default(true)
  branchId  String?
  branch    Branch?  @relation("BranchUsers", fields: [branchId], references: [id])
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens  RefreshToken[]
  officerGroups  Group[]        @relation("OfficerGroups")
  approvedLoans  Loan[]         @relation("ApprovedLoans")
  collections    Collection[]   @relation("CollectorCollections")
  createdMortgages MortgageLoan[] @relation("CreatedMortgageLoans")
  mortgageCollections MortgageCollection[] @relation("CollectorMortgageCollections")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(500)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("refresh_tokens")
}

model Client {
  id          String   @id @default(cuid())
  clientNo    String   @unique // C-001, etc.
  fullname    String
  nic         String   @unique
  phone       String
  address     String?  @db.Text
  job         String?
  status      ClientStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groupMembers GroupMember[]
  instalments  Instalment[]
  guarantors   Guarantor[]
  mortgageLoans MortgageLoan[] @relation("ClientMortgageLoans")
  mortgageInstalments MortgageInstalment[]
  mortgageCollections MortgageCollection[] @relation("ClientMortgageCollections")

  profileImageId String?
  profileImage   Attachment? @relation("ProfileImage", fields: [profileImageId], references: [id])

  createdBy      String?
  updatedBy      String?
  isDeleted      Boolean  @default(false)

  documents      ClientDocument[]

  @@map("clients")
}

model Group {
  id            String   @id @default(cuid())
  groupNo       String?  @unique
  name          String
  branchId      String?
  branch        Branch?  @relation("BranchGroups", fields: [branchId], references: [id])
  location      String?
  collectionDay Int      // 1 = Monday, 7 = Sunday
  officerId     String
  officer       User     @relation("OfficerGroups", fields: [officerId], references: [id])
  
  status        Boolean  @default(true)
  
  members       GroupMember[]
  loans         Loan[]
  collections   Collection[]

  createdBy     String
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  isLeader  Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, clientId])
  @@map("group_members")
}

model Guarantor {
  id        String   @id @default(cuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  
  fullname      String
  nic           String
  phone         String
  address       String   @db.Text
  index         Int      @default(0)
  
  documents     GuarantorDocument[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guarantors")
}

model Loan {
  id                   String   @id @default(cuid())
  loanNo               String   @unique // L-000001, etc.
  groupId              String
  group                Group    @relation(fields: [groupId], references: [id])
  
  leaderLentAmount     Decimal   @db.Decimal(10, 2)
  memberLentAmount     Decimal   @db.Decimal(10, 2)
  totalWeeks           Int
  leaderWeeklyAmount   Decimal   @db.Decimal(10, 2)
  memberWeeklyAmount   Decimal   @db.Decimal(10, 2)
  processingFee        Decimal   @db.Decimal(10, 2)
  
  status               LoanStatus @default(DRAFT)
  rejectionReason      String?    @db.Text
  approvedById         String?
  approvedBy           User?      @relation("ApprovedLoans", fields: [approvedById], references: [id])

  branchId             String?
  branch               Branch?    @relation("BranchLoans", fields: [branchId], references: [id])

  instalments          Instalment[]
  guarantors           Guarantor[]

  createdBy            String
  updatedBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  collections          Collection[]
  @@map("loans")
}

model Instalment {
  id               String   @id @default(cuid())
  loanId           String
  loan             Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id])
  
  weekNumber       Int       // 1, 2, 3...
  dueDate          DateTime  @db.Date
  dueAmount        Decimal   @db.Decimal(10, 2)
  paidAmount       Decimal   @default(0.00) @db.Decimal(10, 2)
  remainingDue     Decimal   @db.Decimal(10, 2) // dueAmount - paidAmount
  status           PaymentStatus @default(UNPAID)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  collectionItems  CollectionItem[]
  @@unique([loanId, clientId, weekNumber])
  @@map("instalments")
}

model DBVersion {
  id        String   @id @default(cuid())
  version   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("db_versions")
}

enum Role {
  ADMIN
  BRANCH_MANAGER
  LOAN_OFFICER
  COLLECTION_OFFICER
  APPROVER
  AUDITOR
  MORTGAGE_OFFICER
  MORTGAGE_COLLECTION
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum LoanStatus {
  DRAFT
  PENDING
  APPROVED
  ACTIVE 
  REJECTED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum CollectionStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model Collection {
  id               String           @id @default(cuid())
  groupId          String
  group            Group            @relation(fields: [groupId], references: [id])
  loanId           String?
  loan             Loan?            @relation(fields: [loanId], references: [id])
  date             DateTime
  weekNumber       Int?
  instalmentNumber Int
  collectorId      String
  collector        User             @relation("CollectorCollections", fields: [collectorId], references: [id])
  amountCollected  Decimal          @db.Decimal(10, 2)
  bankReference    String?
  breakdownNotes   String?          @db.Text
  items            CollectionItem[]
  attachments      CollectionAttachment[]
  status           CollectionStatus @default(SUBMITTED)
  rejectionReason  String?          @db.Text
  
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("collections")
}

model CollectionItem {
  id           String           @id @default(cuid())
  collectionId String
  collection   Collection       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  instalmentId String
  instalment   Instalment       @relation(fields: [instalmentId], references: [id], onDelete: Cascade)
  amount       Decimal          @db.Decimal(10, 2)
  status       CollectionStatus @default(SUBMITTED)
  
  createdAt    DateTime         @default(now())

  @@map("collection_items")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  userId    String
  details   Json?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model Settings {
  id                   String   @id @default("default")
  
  // Blacklist Settings
  lateWeeksFlag        Int      @default(3)
  
  // Loan Settings
  minLoanWeeks         Int      @default(4)
  maxLoanWeeks         Int      @default(52)
  defaultLoanWeeks     Int      @default(50)
  maxActiveLoansGroup  Int      @default(1)
  
  updatedAt            DateTime @updatedAt

  @@map("settings")
}

model NonCollectionWeek {
  id        String   @id @default(cuid())
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("non_collection_weeks")
}

model Attachment {
  id        String   @id @default(cuid())
  fileName  String
  fileType  String
  fileSize  Int
  fileUrl   String   @db.Text
  bucket    String
  objectKey String
  createdAt DateTime @default(now())

  profileClients Client[] @relation("ProfileImage")
  documents      ClientDocument[]
  guarantorDocs  GuarantorDocument[]
  collectionDocs CollectionAttachment[]
  mortgageCollaterals MortgageCollateral[] @relation("CollateralAttachment")
  mortgageTitledFiles MortgageTitledFile[] @relation("TitledAttachment")

  @@map("attachments")
}

model ClientDocument {
  id           String     @id @default(cuid())
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  attachmentId String
  attachment   Attachment @relation(fields: [attachmentId], references: [id])
  type         String     // NIC_FRONT, NIC_BACK, ADDRESS_PROOF, BILLING_PROOF, OTHER
  createdAt    DateTime   @default(now())

  @@map("client_documents")
}

model GuarantorDocument {
  id           String     @id @default(cuid())
  guarantorId  String
  guarantor    Guarantor  @relation(fields: [guarantorId], references: [id], onDelete: Cascade)
  attachmentId String
  attachment   Attachment @relation(fields: [attachmentId], references: [id])
  type         String     // NIC_FRONT, NIC_BACK, ADDRESS_PROOF, BILLING_PROOF, OTHER, PROFILE_IMAGE
  createdAt    DateTime   @default(now())

  @@map("guarantor_documents")
}

model CollectionAttachment {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  attachmentId String
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  note         String?    @db.Text
  createdAt    DateTime   @default(now())

  @@map("collection_attachments")
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]   @relation("BranchUsers")
  groups    Group[]  @relation("BranchGroups")
  loans     Loan[]   @relation("BranchLoans")
  mortgageLoans MortgageLoan[] @relation("BranchMortgageLoans")

  @@map("branches")
}

enum MortgageStatus {
  DRAFT
  PENDING
  APPROVED
  COMPLETED
}

enum AssetType {
  VEHICLE
  PROPERTY
  GOLD
  OTHER
}

model MortgageLoan {
  id                   String             @id @default(cuid())
  loanNo               String             @unique // ML-000001, etc.
  clientId             String
  client               Client             @relation("ClientMortgageLoans", fields: [clientId], references: [id])
  
  lentAmount           Decimal            @db.Decimal(10, 2)
  interestRate         Decimal            @db.Decimal(10, 2)
  upfrontInterest      Decimal            @db.Decimal(10, 2)
  netCashDisbursed     Decimal            @db.Decimal(10, 2)
  monthlyDueAmount     Decimal            @db.Decimal(10, 2)
  dailyPenaltyAmount   Decimal            @db.Decimal(10, 2)
  ltvRatio             Int
  
  assetType            AssetType          @default(OTHER)
  assetDescription     String?            @db.Text
  estimatedMarketValue Decimal            @db.Decimal(10, 2)
  assessedValue        Decimal            @db.Decimal(10, 2)
  
  status               MortgageStatus     @default(DRAFT)
  rejectionReason      String?            @db.Text
  approvedAt           DateTime?
  principalPaid        Decimal            @default(0.00) @db.Decimal(10, 2)
  
  createdById          String
  createdBy            User               @relation("CreatedMortgageLoans", fields: [createdById], references: [id])
  
  branchId             String?
  branch               Branch?            @relation("BranchMortgageLoans", fields: [branchId], references: [id])
  
  collateralFiles      MortgageCollateral[]
  titledFiles          MortgageTitledFile[]
  instalments          MortgageInstalment[]
  collections          MortgageCollection[]
  
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("mortgage_loans")
}

model MortgageCollateral {
  id             String       @id @default(cuid())
  mortgageId     String
  mortgage       MortgageLoan @relation(fields: [mortgageId], references: [id], onDelete: Cascade)
  attachmentId   String
  attachment     Attachment   @relation("CollateralAttachment", fields: [attachmentId], references: [id])
  name           String
  createdAt      DateTime     @default(now())

  @@map("mortgage_collateral")
}

model MortgageTitledFile {
  id             String       @id @default(cuid())
  mortgageId     String
  mortgage       MortgageLoan @relation(fields: [mortgageId], references: [id], onDelete: Cascade)
  attachmentId   String
  attachment     Attachment   @relation("TitledAttachment", fields: [attachmentId], references: [id])
  title          String
  name           String
  createdAt      DateTime     @default(now())

  @@map("mortgage_titled_files")
}

model MortgageInstalment {
  id               String   @id @default(cuid())
  mortgageId       String
  mortgage         MortgageLoan @relation(fields: [mortgageId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id])
  
  monthNumber      Int       // 1, 2, 3...
  dueDate          DateTime  @db.Date
  dueAmount        Decimal   @db.Decimal(10, 2)
  paidAmount       Decimal   @default(0.00) @db.Decimal(10, 2)
  remainingDue     Decimal   @db.Decimal(10, 2) // dueAmount - paidAmount
  status           PaymentStatus @default(UNPAID)
  paidAt           DateTime?

  penaltyAmount        Decimal   @default(0.00) @db.Decimal(10, 2) // accumulated penalty total
  lastPenaltyAppliedAt DateTime? @db.Date                           // last date penalty was calculated

  collectionItems  MortgageCollectionItem[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([mortgageId, clientId, monthNumber])
  @@map("mortgage_instalments")
}

model MortgageCollection {
  id                 String   @id @default(cuid())
  mortgageId         String
  mortgage           MortgageLoan @relation(fields: [mortgageId], references: [id], onDelete: Cascade)
  clientId           String
  client             Client   @relation("ClientMortgageCollections", fields: [clientId], references: [id])

  amount             Decimal  @db.Decimal(10, 2)                  // total payment received
  principalReduction Decimal  @default(0.00) @db.Decimal(10, 2)   // portion applied to principal
  notes              String?  @db.Text

  collectedById      String
  collectedBy        User     @relation("CollectorMortgageCollections", fields: [collectedById], references: [id])

  items              MortgageCollectionItem[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("mortgage_collections")
}

model MortgageCollectionItem {
  id             String   @id @default(cuid())
  collectionId   String
  collection     MortgageCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  instalmentId   String
  instalment     MortgageInstalment @relation(fields: [instalmentId], references: [id])

  penaltyPaid    Decimal  @default(0.00) @db.Decimal(10, 2)  // penalty portion paid
  duePaid        Decimal  @db.Decimal(10, 2)                 // base due portion paid
  totalPaid      Decimal  @db.Decimal(10, 2)                 // penaltyPaid + duePaid

  createdAt      DateTime @default(now())

  @@map("mortgage_collection_items")
}
